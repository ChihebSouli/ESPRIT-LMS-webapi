# ESPRIT LMS — .gitignore

# ── Build output ──

build/
*.class
*.jar
*.war

# ── IDE ──
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# ── OS ──
.DS_Store
Thumbs.db

# ── Environment / Secrets ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Logs ──
*.log
logs/

# ── Temporary files ──
*.tmp
*.swp
